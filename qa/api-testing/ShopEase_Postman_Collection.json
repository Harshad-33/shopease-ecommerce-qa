    {
      "name": "4. Order Management Module",
      "item": [
        {
          "name": "POST Place Order - Success (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Order placed successfully with orderNumber and PLACED status\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('orderNumber');",
                  "    pm.expect(json.status).to.eql('PLACED');",
                  "    pm.collectionVariables.set('orderId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingFullName\": \"Rahul Sharma\",\n  \"shippingAddress\": \"Flat 201, Lotus Apts, MG Road\",\n  \"shippingCity\": \"Bangalore\",\n  \"shippingState\": \"Karnataka\",\n  \"shippingPincode\": \"560001\",\n  \"shippingPhone\": \"9876500001\",\n  \"paymentMethod\": \"CASH_ON_DELIVERY\"\n}"
