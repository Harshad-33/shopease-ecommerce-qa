        },
        {
          "name": "GET All Products (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of 20 products\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.length).to.be.at.least(20);",
                  "    pm.expect(json[0]).to.have.property('price');",
                  "    pm.expect(json[0]).to.have.property('stockQuantity');",
                  "});"
